# ==================== 数据库配置 ====================
# 支持的数据库类型: pgsql, mysql, sqlite
DB_TYPE="pgsql"

# PostgreSQL 配置
# PostgreSQL默认端口: 5432
DB_HOST="localhost"
DB_PORT=5432
DB_NAME="memorycard"
DB_USER="user"
DB_PASSWORD="password"

# MySQL 配置
# MySQL默认端口: 3306 (切换到mysql时需修改端口)
# DB_PORT=3306

# SQLite 配置 (推荐本地开发使用)
# DB_TYPE="sqlite"
DB_FILE="memorycard.db"

# ==================== JWT配置 ====================
# 必须设置，请使用随机字符串
SECRET_KEY="your-secret-key-change-this-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=360

# ==================== 日志配置 ====================
# 日志级别: trace, debug, info, success, warning, error
LOG_LEVEL="info"
# 日志轮转大小，如 "10 MB"
LOG_ROTATION="1 MB"
# 日志保留时间，如 "1 weeks", "30 days"
LOG_RETENTION="1 months"
